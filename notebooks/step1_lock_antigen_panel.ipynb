#!/usr/bin/env python3
"""
Step 1 — Lock the candidate antigen panel.

Purpose
-------
Produces a single reference file (panel.json) that every downstream step in
this pipeline reads from. Nothing downstream re-decides or re-types an
antigen identity; it only reads this file.

This step does NOT predict, align, or fold anything. It has no GPU
requirement and is not a Colab task — it is a local curation and
verification step.

What it does
------------
1. Defines the four candidate cardiac autoantigens plus the spike reference,
   each carrying a documented justification tied to the specific predecessor
   study that named it (per the locked project design: literature-anchored
   panel, not a broader systematic sweep).
2. Independently re-verifies every accession against the live UniProt REST
   API before writing anything to disk. If an accession does not resolve,
   resolves to the wrong gene/organism, or resolves to an unreviewed
   (TrEMBL) entry where a reviewed (Swiss-Prot) entry should exist, the
   script raises and refuses to write the panel file. This mirrors the
   verification discipline applied after the Regolyx accession crisis:
   never trust an inherited accession list without checking it live.
3. Writes panel.json — the locked reference every later step consumes.

Usage
-----
    python3 step1_lock_antigen_panel.py

Requires network access to rest.uniprot.org. Run locally, not on Colab.
"""

import json
import sys
import time
from datetime import datetime, timezone
from pathlib import Path

import requests

UNIPROT_BASE = "https://rest.uniprot.org/uniprotkb"
REQUEST_HEADERS = {
    "User-Agent": "myocarditis-mimicry-pipeline/1.0 (research use; contact author via GitHub repo)"
}
REQUEST_TIMEOUT = 20
REQUEST_DELAY_SECONDS = 1.0  # be polite to the API between calls

OUTPUT_PATH = Path(__file__).resolve().parent / "panel.json"

# ---------------------------------------------------------------------------
# Locked panel definition
# ---------------------------------------------------------------------------
# Each entry states not just the identifier, but WHY it is here — the
# specific predecessor study that named it — so the justification is
# auditable rather than asserted.

PANEL_DEFINITION = {
    "spike": {
        "accession": "P0DTC2",
        "symbol": "SARS-CoV-2 Spike",
        "expected_gene": None,  # viral protein, no HGNC gene symbol
        "expected_organism_substring": "Severe acute respiratory syndrome coronavirus 2",
        "expected_reviewed": True,
        "role": "query_protein",
        "justification": (
            "Wuhan reference spike sequence. Matches the sequence used in the "
            "original mRNA vaccine formulations administered during the period "
            "in which most reported myocarditis cases occurred, and matches the "
            "sequence used in both predecessor studies this project reassesses "
            "(Kanduc-lineage linear peptide-sharing analyses; eBioMedicine "
            "structural/sequence comparison). Variant spike sequences are "
            "explicitly out of scope for this study."
        ),
    },
    "MYH6": {
        "accession": "P13533",
        "symbol": "MYH6",
        "expected_gene": "MYH6",
        "expected_organism_substring": "Homo sapiens",
        "expected_reviewed": True,
        "role": "candidate_autoantigen",
        "justification": (
            "Cardiac alpha-myosin heavy chain. Named as a candidate cross-reactive "
            "target in Kanduc-lineage linear peptide-sharing analyses. Included in "
            "the eBioMedicine structural/sequence null-result comparison. Distinct "
            "from MYH7 (beta-myosin heavy chain, the skeletal/slow isoform) — "
            "verified explicitly to avoid isoform confusion."
        ),
    },
    "TPM1": {
        "accession": "P09493",
        "symbol": "TPM1",
        "expected_gene": "TPM1",
        "expected_organism_substring": "Homo sapiens",
        "expected_reviewed": True,
        "role": "candidate_autoantigen",
        "justification": (
            "Cardiac-disease-linked tropomyosin alpha-1 isoform, predominant "
            "tropomyosin isoform in striated/cardiac muscle. Named explicitly in "
            "Kanduc-lineage mimicry analyses and in the eBioMedicine comparison. "
            "Canonical isoform 1 accession used; alternate spliced isoforms "
            "(e.g. kappa-Tpm) are not used in this panel."
        ),
    },
    "TPM3": {
        "accession": "P06753",
        "symbol": "TPM3",
        "expected_gene": "TPM3",
        "expected_organism_substring": "Homo sapiens",
        "expected_reviewed": True,
        "role": "candidate_autoantigen",
        "justification": (
            "Cardiac-disease-linked tropomyosin alpha-3 isoform (gamma-Tm). "
            "Named alongside TPM1 in both predecessor investigations this study "
            "reassesses."
        ),
    },
    "ACTC1": {
        "accession": "P68032",
        "symbol": "ACTC1",
        "expected_gene": "ACTC1",
        "expected_organism_substring": "Homo sapiens",
        "expected_reviewed": True,
        "role": "candidate_autoantigen",
        "justification": (
            "Cardiac alpha-actin. Binding partner of the tropomyosin isoforms "
            "above in the sarcomeric thin filament; named in the same "
            "predecessor mimicry literature as a candidate cardiac autoantigen."
        ),
    },
}


class AccessionVerificationError(RuntimeError):
    """Raised when a live UniProt lookup does not match what the panel expects."""


def fetch_uniprot_entry(accession: str) -> dict:
    url = f"{UNIPROT_BASE}/{accession}.json"
    resp = requests.get(url, headers=REQUEST_HEADERS, timeout=REQUEST_TIMEOUT)
    if resp.status_code != 200:
        raise AccessionVerificationError(
            f"UniProt lookup failed for {accession}: HTTP {resp.status_code}. "
            f"Body: {resp.text[:300]}"
        )
    return resp.json()


def verify_entry(key: str, spec: dict) -> dict:
    """Verify one panel entry against a live UniProt record. Returns a result dict."""
    accession = spec["accession"]
    print(f"  Verifying {key} ({accession}) ...", end=" ", flush=True)

    data = fetch_uniprot_entry(accession)

    entry_type = data.get("entryType", "")
    is_reviewed = "Swiss-Prot" in entry_type

    organism = data.get("organism", {}).get("scientificName", "")
    genes = data.get("genes", [])
    gene_name = genes[0].get("geneName", {}).get("value") if genes else None

    protein_desc = data.get("proteinDescription", {})
    full_name = (
        protein_desc.get("recommendedName", {}).get("fullName", {}).get("value")
        or protein_desc.get("submissionNames", [{}])[0].get("fullName", {}).get("value", "N/A")
    )
    length = data.get("sequence", {}).get("length")
    sequence = data.get("sequence", {}).get("value")

    problems = []

    if spec["expected_reviewed"] and not is_reviewed:
        problems.append(f"expected reviewed Swiss-Prot entry, got entryType={entry_type!r}")

    expected_org = spec.get("expected_organism_substring")
    if expected_org and expected_org not in organism:
        problems.append(f"expected organism containing {expected_org!r}, got {organism!r}")

    expected_gene = spec.get("expected_gene")
    if expected_gene and gene_name != expected_gene:
        problems.append(f"expected gene symbol {expected_gene!r}, got {gene_name!r}")

    if not sequence:
        problems.append("no sequence returned")

    if problems:
        print("MISMATCH")
        raise AccessionVerificationError(
            f"Verification failed for {key} ({accession}): " + "; ".join(problems)
        )

    print(f"OK — {full_name} | gene={gene_name} | organism={organism} | {length} aa | {entry_type}")

    return {
        "accession": accession,
        "verified_full_name": full_name,
        "verified_gene": gene_name,
        "verified_organism": organism,
        "verified_length_aa": length,
        "verified_entry_type": entry_type,
        "sequence": sequence,
    }


def main() -> int:
    print("Step 1 — Locking candidate antigen panel")
    print("=" * 60)
    print(f"Verifying {len(PANEL_DEFINITION)} accessions against live UniProt ...\n")

    locked_panel = {
        "pipeline_step": 1,
        "generated_at_utc": datetime.now(timezone.utc).isoformat(),
        "verification_source": "https://rest.uniprot.org",
        "note": (
            "Every accession below was independently re-verified against the "
            "live UniProt API at generation time, not assumed from a hardcoded "
            "list. See 'verified_*' fields per entry for what was actually "
            "returned by UniProt at verification time."
        ),
        "entries": {},
    }

    try:
        for i, (key, spec) in enumerate(PANEL_DEFINITION.items()):
            verified = verify_entry(key, spec)
            locked_panel["entries"][key] = {
                "symbol": spec["symbol"],
                "role": spec["role"],
                "justification": spec["justification"],
                **verified,
            }
            if i < len(PANEL_DEFINITION) - 1:
                time.sleep(REQUEST_DELAY_SECONDS)
    except AccessionVerificationError as e:
        print(f"\nABORTED — panel.json was NOT written.\nReason: {e}", file=sys.stderr)
        return 1
    except requests.RequestException as e:
        print(
            f"\nABORTED — network error reaching UniProt, panel.json was NOT written.\n"
            f"Reason: {e}\n"
            f"If running in a sandboxed environment, confirm rest.uniprot.org "
            f"is reachable (this step requires network access and is intended "
            f"to run on your local machine, not a restricted sandbox).",
            file=sys.stderr,
        )
        return 1

    OUTPUT_PATH.write_text(json.dumps(locked_panel, indent=2))
    print(f"\nAll {len(PANEL_DEFINITION)} accessions verified successfully.")
    print(f"Panel written to: {OUTPUT_PATH}")
    print("\nDownstream steps (Step 2 onward) should read panel.json and must")
    print("never redefine or re-type an accession independently.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
