/*
========================================================================================
    structural-mimicry-nf configuration
========================================================================================
*/

manifest {
    name            = 'structural-mimicry-nf'
    author          = 'John Adeyemo Adedeji'
    homePage        = 'https://github.com/Jonahnki/structural-mimicry-nf'
    description     = 'Generalized structural mimicry screening between an arbitrary query protein and candidate antigen set, demonstrated on SARS-CoV-2 spike vs. cardiac autoantigens'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}

params {
    // Input/output
    panel_samplesheet   = null
    query_conformations = null
    outdir              = './results'

    // Fragment-level analysis
    fragment_window      = 30
    fragment_stride       = 15
    min_aln_length       = 15
    patch_tm_threshold   = 0.3

    // Statistical validation
    n_null_proteins    = 300
    significance_alpha = 0.05

    // Antigenicity scoring
    exposed_threshold = 0.25

    // Max resource options
    max_memory = '32.GB'
    max_cpus   = 8
    max_time   = '24.h'
}

profiles {
    conda {
        conda.enabled          = true
        docker.enabled         = false
        singularity.enabled    = false
    }
    docker {
        docker.enabled         = true
        docker.userEmulation   = true
        singularity.enabled    = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    test {
        params.panel_samplesheet   = "${projectDir}/assets/samplesheets/demo_spike_cardiac_panel.csv"
        params.query_conformations = "${projectDir}/assets/samplesheets/demo_spike_conformations.csv"
        params.n_null_proteins     = 20  // reduced for fast CI testing
    }
}

process {
    withLabel: process_single {
        cpus   = 1
        memory = '4.GB'
        time   = '1.h'
    }
    withLabel: process_medium {
        cpus   = 4
        memory = '8.GB'
        time   = '4.h'
    }
    withLabel: process_high {
        cpus   = 8
        memory = '16.GB'
        time   = '12.h'
    }
    withLabel: process_gpu {
        // ESMFold fallback folding requires GPU. On Colab this runs interactively;
        // in a cluster/cloud context, request a GPU-enabled queue/accelerator here.
        accelerator = 1
    }
}

// Reproducibility: pin container digests, not just tags, once published
docker.registry       = 'quay.io'
singularity.registry  = 'quay.io'

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace.txt"
}
